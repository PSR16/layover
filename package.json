{
  "name": "layover",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first web app that coordinates dawn bird-collision patrols for existing volunteer groups",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "secretlint \"**/*\"",
    "check": "npm run lint && npm run format:check && npm run secrets && npm test && npm run build",
    "prepare": "husky",
    "unused": "knip"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.3",
    "eslint-plugin-unicorn": "59.0.1",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "secretlint": "14.1.0",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
